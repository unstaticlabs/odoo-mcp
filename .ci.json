{
  "version": 1,
  "steps": [
    {
      "name": "install",
      "cmd": "SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm ci",
      "cwd": ".",
      "timeout": 600,
      "gate": true
    },
    {
      "name": "typecheck",
      "cmd": "npm run typecheck",
      "cwd": ".",
      "timeout": 300,
      "gate": true
    },
    {
      "name": "test",
      "cmd": "npm test",
      "cwd": ".",
      "timeout": 300,
      "gate": true
    },
    {
      "name": "build",
      "cmd": "npm run build",
      "cwd": ".",
      "timeout": 300,
      "gate": true
    }
  ]
}
