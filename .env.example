MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_ORIGIN=https://mcp.example.com
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=chatgpt.com,claude.ai

ODOO_PUBLIC_ORIGIN=https://odoo.example.com
ODOO_INTERNAL_ORIGIN=http://odoo:8069
ODOO_DATABASE=production
# For multiple configured targets, replace the three values above with:
# ODOO_TARGETS_JSON=[{"id":"primary","publicOrigin":"https://odoo.example.com","internalOrigin":"http://odoo:8069","databases":["production"]}]
# HTTP public origins are restricted to explicitly enabled loopback development.
MCP_ALLOW_LOCAL_HTTP_ODOO=false

# Required only by the stdio entrypoint. HTTP clients submit their own key.
ODOO_API_KEY=replace-me

MCP_TARGET_CONCURRENCY=8
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_RESPONSE_BYTES=1048576

# Optional privacy-filtered PostHog MCP Analytics. Disabled by default.
MCP_ANALYTICS_ENABLED=false
MCP_ENVIRONMENT=production
# When enabled, provide every value below. Prefer the *_FILE forms for secrets.
# POSTHOG_API_KEY_FILE=/run/secrets/posthog_api_key
# POSTHOG_HOST=https://eu.i.posthog.com
# MCP_ANALYTICS_PSEUDONYMIZATION_KEY_FILE=/run/secrets/analytics_pseudonymization_key
# MCP_DEPLOYMENT_ID=usl-prod-vps-1
# MCP_BUILD_ID=replace-with-git-sha-or-image-digest

# Optional OAuth for hosted MCP clients. Generate each secret independently.
MCP_OAUTH_ENABLED=true
MCP_OAUTH_DATABASE=/data/oauth.sqlite
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret
MCP_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/credential_encryption_key
MCP_OAUTH_TRUSTED_ORIGINS=https://chatgpt.com,https://claude.ai
MCP_OAUTH_ACCESS_TOKEN_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_SECONDS=15552000
MCP_OAUTH_GRANT_CEILING_SECONDS=31536000
