MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PUBLIC_ORIGIN=https://mcp.example.com
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_ALLOWED_ORIGINS=chatgpt.com,claude.ai

ODOO_PUBLIC_ORIGIN=https://odoo.example.com
