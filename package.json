{
  "name": "odoo-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist/http.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/http.ts",
    "start": "node dist/http.js",
    "stdio": "node dist/stdio.js",
    "oauth:migrate": "node dist/auth/cli.js migrate",
    "oauth:prepare": "node dist/auth/cli.js prepare",
    "oauth:backup": "node dist/auth/cli.js backup",
    "eval:validate": "npm run build && node dist/evals/cli.js validate",
    "eval:surfaces": "npm run build && node dist/evals/cli.js surfaces",
    "check:release-contract": "node scripts/release-contract.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/vps test/evals",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest test/vps test/evals",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.14",
    "@better-auth/mcp": "1.7.14",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@posthog/mcp": "0.25.0",
    "better-auth": "1.7.14",
    "better-sqlite3": "^13.0.0",
    "express": "^5.1.0",
    "posthog-node": "5.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "^9.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.0.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
