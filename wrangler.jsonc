{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "odoo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {},
  "kv_namespaces": [
    {
      // Token/grant/client storage for the ChatGPT OAuth shim
      // (@cloudflare/workers-oauth-provider). Odoo credentials inside grants
      // are end-to-end encrypted; see docs/product/auth.md.
      "binding": "OAUTH_KV",
      "id": "87163e0f22e54140b5e87ed656844cc7"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "McpAgent",
        "class_name": "McpAgent"
      },
      {
        "name": "AccountingAgent",
        "class_name": "AccountingAgent"
      },
      {
        "name": "ProjectsAgent",
        "class_name": "ProjectsAgent"
      },
      {
        "name": "DocumentsAgent",
        "class_name": "DocumentsAgent"
      },
      {
        "name": "OdooOriginCoordinator",
        "class_name": "OdooOriginCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McpAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountingAgent", "ProjectsAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DocumentsAgent"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["OdooOriginCoordinator"]
    }
  ]
}
